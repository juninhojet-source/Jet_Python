<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS como proxy reverso do Sistema MCMV.
  Encaminha todas as requisições do site (hostname) para o Waitress em
  http://127.0.0.1:8000. Requer os módulos "URL Rewrite" e
  "Application Request Routing (ARR)" instalados, e o proxy do ARR habilitado
  (o script configurar-iis.ps1 faz isso).

  HTTPS: enquanto o acesso for por HTTP, mantenha X-Forwarded-Proto = "http".
  Ao publicar com certificado (HTTPS) no IIS, altere o valor para "https" e
  ajuste o .env do Django (DJANGO_SSL_REDIRECT=1).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_PROTO" />
      </allowedServerVariables>
      <rules>
        <rule name="MCMV - Proxy reverso para Waitress" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="http" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- Permite upload de documentos até 50 MB. -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
