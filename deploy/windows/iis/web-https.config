<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS como proxy reverso HTTPS do Sistema MCMV.
  - Redireciona todo HTTP (porta 80) para HTTPS (porta 443).
  - Encaminha as requisicoes HTTPS para o Waitress em http://127.0.0.1:8000,
    repassando X-Forwarded-Proto = "https" (o Django trata como seguro).
  Requer os modulos "URL Rewrite" e "Application Request Routing (ARR)" e o
  proxy do ARR habilitado (o script configurar-https.ps1 cuida disso).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_PROTO" />
      </allowedServerVariables>
      <rules>
        <rule name="MCMV - Redirecionar HTTP para HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Found" />
        </rule>
        <rule name="MCMV - Proxy reverso para Waitress" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- Permite upload de documentos ate 50 MB. -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
