# SIGTRANS Saúde — exemplo de variáveis de ambiente
# Copie para .env e ajuste. NÃO versione o arquivo .env real.

# --- Geral ---
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,sigtrans.baraodecocais.mg.gov.br
CSRF_TRUSTED_ORIGINS=https://sigtrans.baraodecocais.mg.gov.br

# --- Banco de dados (produção: PostgreSQL) ---
# Se POSTGRES_DB estiver definido, o sistema usa PostgreSQL; senão, usa SQLite (dev).
POSTGRES_DB=sigtrans
POSTGRES_USER=sigtrans
POSTGRES_PASSWORD=defina-uma-senha-forte
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Sessão / segurança ---
SESSION_COOKIE_AGE=1800
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# --- Agenda (Fase 2) ---
AGENDA_HORA_INICIO=05:00
AGENDA_HORA_FIM=18:00

# --- Criação do administrador (opcional, usado por manage.py criar_admin) ---
# SIGTRANS_ADMIN_SENHA=defina-uma-senha-forte
