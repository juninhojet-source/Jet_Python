# Exemplo de configuração de ambiente — copie para .env e ajuste.
# NUNCA versione o .env real (contém segredos). Em produção, prefira
# injetar estas variáveis pelo systemd/ambiente do servidor.

# --- Django ---
DJANGO_DEBUG=0
# Gere uma chave: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DJANGO_ALLOWED_HOSTS=habitacao.baraodecocais.mg.gov.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://habitacao.baraodecocais.mg.gov.br
DJANGO_BEHIND_PROXY=1
DJANGO_SESSION_AGE=1800
DJANGO_LOG_LEVEL=INFO

# --- Banco de dados PostgreSQL (produção) ---
POSTGRES_DB=mcmv
POSTGRES_USER=mcmv
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60

# --- Caminhos ---
# Documentos (dados sensíveis) fora da raiz web:
MCMV_MEDIA_ROOT=/var/lib/mcmv/media
MCMV_LOG_DIR=/var/log/mcmv

# --- Backup (scripts/backup.sh) ---
# Destinatário GPG para criptografar os backups (chave pública importada):
BACKUP_GPG_RECIPIENT=backup@baraodecocais.mg.gov.br
BACKUP_DIR=/var/backups/mcmv
