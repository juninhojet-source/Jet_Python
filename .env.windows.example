# Exemplo de .env para TESTE PRÁTICO em Windows Server (rede interna, via HTTP).
# Copie para .env (na raiz do projeto) e ajuste. NÃO versione o .env real.
#
# Gere a SECRET_KEY (no venv):
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"

# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=cole-aqui-uma-chave-aleatoria-longa
# Inclua SEMPRE 127.0.0.1 e localhost (acesso no proprio servidor) e adicione o
# IP e/ou o nome do servidor na rede (separados por virgula, sem espacos):
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.0.10,servidor-habitacao
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://192.168.0.10:8000,http://servidor-habitacao:8000

# Teste em HTTP na LAN (sem certificado): desliga redirect HTTPS/HSTS e cookies "Secure".
# Ao publicar com HTTPS de verdade, remova estas duas linhas (voltam a valer os padrões seguros).
DJANGO_SSL_REDIRECT=0
DJANGO_BEHIND_PROXY=0

DJANGO_SESSION_AGE=1800
DJANGO_LOG_LEVEL=INFO

# --- Caminhos (Windows) ---
# Documentos (dados sensíveis) fora da pasta pública de estáticos:
MCMV_MEDIA_ROOT=C:\mcmv\media
MCMV_LOG_DIR=C:\mcmv\logs

# Backup (banco + documentos). De preferência aponte para outro disco/local seguro.
MCMV_BACKUP_DIR=C:\mcmv\backups
MCMV_BACKUP_RETENCAO_DIAS=30

# --- Servidor Waitress ---
MCMV_HOST=0.0.0.0
MCMV_PORT=8000
MCMV_THREADS=8

# --- Banco ---
# Para o teste inicial, deixe SEM as variáveis POSTGRES_* → usa SQLite (db.sqlite3).
# Para PostgreSQL no Windows, descomente e ajuste:
# POSTGRES_DB=mcmv
# POSTGRES_USER=mcmv
# POSTGRES_PASSWORD=troque-esta-senha
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=prefer
